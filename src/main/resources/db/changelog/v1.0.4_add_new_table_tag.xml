<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
    <!--JUNIOR-разработчик. Чел, которому нужен другой чел и опора, чтобы он решал задачки.-->
    <!--MIDDLE-разработчик. Чел, которому не нужен другой чел. Он может самостоятельно решить задачки.-->
    <!--SENIOR-разработчик. Чел, которому не нужен другой чел. Чел, который может самостоятельно решить задачки. Чел, который решает задачки самым эффективным способом.-->
    <changeSet id="create-table-tag" author="Anfear">
        <createTable tableName="tag">
            <column name="id" type="int" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
        <createTable tableName="quote_tag">
            <column name="quote_id" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_quote_tag_quote"
                             references="quote(id)"/>
            </column>
            <column name="tag_id" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_quote_tag_tag"
                             references="tag(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="quote_tag" columnNames="quote_id, tag_id" constraintName="pk_quote_tag"/>
    </changeSet>

</databaseChangeLog>